<launch>
    <arg name="car_name" default="car_2"/>
    <arg name="raceline" default="raceline"/>

    <node pkg="f1tenth_purepursuit"
          type="stanley_avoidance.py"
          name="stanley_avoidance"
          output="screen"
          args="$(arg car_name) $(arg raceline)">
    </node>
</launch>
